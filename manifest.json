{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Indeed Job Map Pro"
  },
  "content_scripts": [
    {
      "css": [
        "leaflet/leaflet.css",
        "content.css"
      ],
      "js": [
        "leaflet/leaflet.js",
        "content.js"
      ],
      "matches": [
        "https://ca.indeed.com/*",
        "https://www.indeed.com/*",
        "https://indeed.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Auto scrolls the Indeed job list to the end, keeps only jobs within your radius across Canada using exact address and driving distance, with an OpenStreetMap view that stays inside Canada, page by page or automated all pages mode, and a map that updates when the page changes.",
  "host_permissions": [
    "https://ca.indeed.com/*",
    "https://www.indeed.com/*",
    "https://indeed.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://router.project-osrm.org/*",
    "https://tile.openstreetmap.org/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "Indeed Job Map Pro",
  "permissions": [
    "storage"
  ],
  "version": "1.17.0",
  "web_accessible_resources": [
    {
      "matches": [
        "https://ca.indeed.com/*",
        "https://www.indeed.com/*",
        "https://indeed.com/*"
      ],
      "resources": [
        "icons/icon32.png",
        "icons/icon48.png",
        "leaflet/leaflet.js",
        "leaflet/leaflet.css"
      ]
    }
  ]
}